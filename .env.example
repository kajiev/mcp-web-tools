# Secret key used by SearXNG for signing (image-proxy HMAC, internal tokens) —
# NOT an API key, never sent by clients. Must be random; SearXNG won't run with
# the default. `./install.sh` generates one automatically. Generate by hand with:
#   openssl rand -hex 32
SEARXNG_SECRET=

# Bearer token for the Crawl4AI API. Required since Crawl4AI 0.9.0: without it
# the server binds loopback-only inside its container and refuses /md, so the
# web-mcp container cannot reach it. `./install.sh` generates one automatically.
# Generate by hand with:
#   openssl rand -hex 32
CRAWL4AI_API_TOKEN=

# Optional bearer token to protect the REST API (/api/v1/*). Leave empty to disable auth.
API_TOKEN=

# Provider fallback chains (tavily → firecrawl → exa → local). Run once:
#   make config
# Path inside the container when using docker compose (default below).
#PROVIDERS_CONFIG=config/providers.yaml
# Include fallback_attempts in search/extract responses when true.
#FALLBACK_VERBOSE=false
# Optional API keys referenced from providers.yaml via ${VAR} interpolation
#TAVILY_API_KEY=
#FIRECRAWL_API_KEY=
#EXA_API_KEY=

# MCP server transport: "http" (streamable-http, good for remote/multi-agent) or
# "stdio" (single local client launched as a subprocess).
MCP_TRANSPORT=http

# Host port for the MCP server (container also binds this internally).
MCP_PORT=8000

# Cache TTL in seconds for the MCP layer. Set to 0 to disable that cache.
MCP_CACHE_TTL=300
EXTRACT_CACHE_TTL=1800

# Timeouts (seconds) and parallelism for outbound calls.
REQUEST_TIMEOUT=30
EXTRACT_TIMEOUT=60
MAX_CONCURRENCY=5

# Image tags — override to pin versions for a reproducible install elsewhere.
# crawl4ai is pinned to 0.9.x by default (its Docker API is secure-by-default
# since 0.9.0); override here to track a different version.
#VALKEY_IMAGE=valkey/valkey:8-alpine
#SEARXNG_IMAGE=searxng/searxng:2026.11.19-368baa340
CRAWL4AI_IMAGE=unclecode/crawl4ai:0.9.5
